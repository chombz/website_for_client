ces/troubleshooting/troubleshooting-your-connection-to-github-codespaces) documentation for other solutions.\n\nNote: This is not recommended and may expose your codespace data to third parties if you are not on a private network.","default":false,"scope":"application"},"github.codespaces.supportProxies":{"type":"boolean","markdownDescription":"Allows proxies to make `CONNECT` requests when connecting to codespaces.","default":false,"scope":"application"}}},"commands":[{"command":"github.codespaces.activate","title":"Activate","category":"Codespaces"},{"command":"github.codespaces.exportLogs","title":"Export Logs","category":"Codespaces"},{"command":"github.codespaces.addEnvironment","title":"Create New Codespace...","category":"Codespaces","icon":{"dark":"images/dark/add.svg","light":"images/light/add.svg"},"enablement":"!isWeb || remoteName != codespaces"},{"command":"github.codespaces.continueEditSessionInCodespace","title":"Create New Codespace...","category":"Codespaces","icon":"$(github)"},{"command":"github.codespaces.continueEditSessionInCodespaceWithJupyterServer","title":"Connect to Codespace...","category":"Codespaces","icon":"$(github)"},{"command":"github.codespaces.refresh","title":"Refresh","category":"Codespaces","icon":{"dark":"images/dark/refresh.svg","light":"images/light/refresh.svg"}},{"command":"github.codespaces.connect","title":"Connect to Codespace...","category":"Codespaces","icon":"$(plug)","enablement":"!isWeb || remoteName != codespaces"},{"command":"github.codespaces.disconnectEnvironment","title":"Disconnect","category":"Codespaces","icon":"$(debug-disconnect)","enablement":"remoteName == codespaces"},{"command":"github.codespaces.reloadServer","title":"Kill VS Code Server on Host...","category":"Codespaces"},{"command":"github.codespaces.shutdownEnvironment","title":"Stop Codespace","category":"Codespaces","icon":"$(primitive-square)"},{"command":"github.codespaces.disconnectSuspend","title":"Stop Current Codespace","category":"Codesp