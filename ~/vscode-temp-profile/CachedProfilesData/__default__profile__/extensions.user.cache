/out/extension.js","contributes":{"commands":[{"command":"livePreview.start","title":"Start Server","category":"Live Preview"},{"command":"livePreview.start.preview.atFile","title":"Show Preview","category":"Live Preview","icon":"$(open-preview)"},{"command":"livePreview.start.debugPreview.atFile","title":"Show Debug Preview","category":"Live Preview","icon":"$(debug-alt)"},{"command":"livePreview.start.externalPreview.atFile","title":"Show Preview (External Browser)","category":"Live Preview"},{"command":"livePreview.start.externalDebugPreview.atFile","title":"Show Debug Preview (External Browser)","category":"Live Preview","icon":"$(debug-alt)"},{"command":"livePreview.start.internalPreview.atFile","title":"Show Preview (Internal Browser)","category":"Live Preview"},{"command":"livePreview.setDefaultOpenFile","title":"Open Automatically on Server Start","category":"Live Preview"},{"command":"livePreview.runServerLoggingTask","title":"Start Server Logging","category":"Live Preview"},{"command":"livePreview.end","title":"Stop Server","category":"Live Preview"},{"command":"livePreview.start.preview.atFileString","title":"Start Server at File Path String","category":"Live Preview"}],"menus":{"editor/title":[{"command":"livePreview.start.preview.atFile","when":"editorLangId == html && !notebookEditorFocused","group":"navigation"}],"explorer/context":[{"command":"livePreview.start.preview.atFile","when":"resourceLangId == html","group":"1_livepreview@1"},{"command":"livePreview.setDefaultOpenFile","when":"resourceLangId == html","group":"1_livepreview@2"}],"editor/context":[{"command":"livePreview.start.preview.atFile","when":"resourceLangId == html","group":"1_livepreview@1"},{"command":"livePreview.setDefaultOpenFile","when":"resourceLangId == html","group":"1_livepreview@2"}],"commandPalette":[{"command":"livePreview.start","when":"!LivePreviewServerOn"},{"command":"livePreview.start.preview.atFile","when":"false"},{"command":"livePreview.start.preview.atFileString",